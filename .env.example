TRIPMIND_AI_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_key
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENAI_API_KEY=replace_with_your_openai_key
XAI_API_KEY=replace_with_your_xai_key_if_using_grok
TRIPMIND_PLACES_PROVIDER=hybrid
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
OPENTRIPMAP_API_KEY=replace_with_your_opentripmap_key
TRIPMIND_WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=replace_with_your_openweather_key

# Optional Spring AI understanding + plan copilot (offline comparisons work without this).
# Set model=openai to enable the OpenAI-compatible client, including for Groq.
TRIPMIND_SPRING_AI_MODEL=none
TRIPMIND_SPRING_AI_BASE_URL=https://api.groq.com/openai/v1
TRIPMIND_SPRING_AI_CHAT_MODEL=qwen/qwen3.8-27b
TRIPMIND_SPRING_AI_API_KEY=
